@model HomeworkTMSWeb.ViewModels.AnalyticsViewModel

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-dark text-white text-center py-3">
        <h5 class="mb-0">Аналитика инвентаря</h5>
    </div>
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
            <span class="text-muted">Общая стоимость всех товаров:</span>
            <h4 class="text-primary mb-0 fw-bold">@Model.TotalSum.ToString("C")</h4>
        </div>

        <form asp-controller="Analytics" asp-action="ShowAnalytics" method="get">
            <div class="mb-4">
                <label class="form-label fw-semibold mb-2">Просмотр по категории</label>
                <div class="input-group shadow-sm d-flex gap-2">
                    <select name="category" class="form-select border-primary" asp-items="Html.GetEnumSelectList<HomeworkTMSWeb.Enums.ProductCategory>()"></select>
                    <button type="submit" class="btn btn-primary px-4">Узнать статистику</button>
                </div>
            </div>
        </form>

        @if (Model.SelectedCategorySum.HasValue)
        {
            <div class="alert alert-info mt-4 py-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fs-5">@Model.SelectedCategoryName:</span>
                    <span class="fw-bold fs-5">@Model.SelectedCategorySum.Value.ToString("F2") ₽</span>
                </div>
            </div>
        }
    </div>
</div>