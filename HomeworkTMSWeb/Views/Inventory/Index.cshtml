@model IEnumerable<HomeworkTMSWeb.Models.Product>

@{
    ViewData["Title"] = "Учет инвентаря";
}

<div class="container mt-4">
    <h2 class="mb-4 d-flex justify-content-center">Список товаров на складе</h2>

    <table class="table table-striped table-hover border">
        <thead class="table-dark">
            <tr>
                <th>Имя</th>
                <th>Категория</th>
                <th>Цена</th>
                <th>Количество</th>
                <th>Изменение товара</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Category.ToString()</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>@item.Quantity шт.</td>
                    <td>
                        <a asp-controller="Inventory" asp-action="UpdateProduct" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning text-black">Редактировать</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>